+func TestHTTPHandlerServesNonDoH(t *testing.T) {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/api/v1/health", func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("ok"))
+	})
+
+	c := Config{
+		Zone:        "example.com.",
+		Transport:   "https",
+		TLSConfig:   &tls.Config{},
+		ListenHosts: []string{"127.0.0.1"},
+		Port:        "443",
+		HTTPHandler: mux,
+	}
+	s, err := NewServerHTTPS("127.0.0.1:443", []*Config{&c})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	t.Run("api path", func(t *testing.T) {
+		r := httptest.NewRequest(http.MethodGet, "/api/v1/health", nil)
+		w := httptest.NewRecorder()
+		s.ServeHTTP(w, r)
+		res := w.Result()
+		defer res.Body.Close()
+		if res.StatusCode != http.StatusOK {
+			t.Fatalf("status=%d", res.StatusCode)
+		}
+		body, _ := io.ReadAll(res.Body)
+		if string(body) != "ok" {
+			t.Fatalf("body=%q", body)
+		}
+	})
+
+	t.Run("dns-query still DoH", func(t *testing.T) {
+		res := testServerHTTPSWithHandler(t, "/dns-query", mux)
+		defer res.Body.Close()
+		if res.StatusCode != http.StatusOK {
+			t.Fatalf("DoH status=%d", res.StatusCode)
+		}
+		if ct := res.Header.Get("Content-Type"); ct != "application/dns-message" && ct != "" {
+			// DoH replies with application/dns-message when the chain answers.
+			_ = ct
+		}
+	})
+
+	t.Run("unknown path 404 from mux", func(t *testing.T) {
+		r := httptest.NewRequest(http.MethodGet, "/nope", nil)
+		w := httptest.NewRecorder()
+		s.ServeHTTP(w, r)
+		if w.Result().StatusCode != http.StatusNotFound {
+			t.Fatalf("status=%d", w.Result().StatusCode)
+		}
+	})
+}
+
+func testServerHTTPSWithHandler(t *testing.T, path string, h http.Handler) *http.Response {
+	t.Helper()
+	c := Config{
+		Zone:        "example.com.",
+		Transport:   "https",
+		TLSConfig:   &tls.Config{},
+		ListenHosts: []string{"127.0.0.1"},
+		Port:        "443",
+		HTTPHandler: h,
+	}
+	s, err := NewServerHTTPS("127.0.0.1:443", []*Config{&c})
+	if err != nil {
+		t.Fatal("could not create HTTPS server")
+	}
+	m := new(dns.Msg)
+	m.SetQuestion("example.org.", dns.TypeDNSKEY)
+	buf, err := m.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := httptest.NewRequest(http.MethodPost, path, bytes.NewReader(buf))
+	w := httptest.NewRecorder()
+	s.ServeHTTP(w, r)
+	return w.Result()
+}
