# Admin plugin + DoH on plain HTTP :8443 (no TLS terminator in this compose stack).
# The catch-all `.` block serves admin-created zones on :53; example.com stays
# on dns-update-persistent and must not share that origin with admin.
#
# prometheus is first in every server block that answers DNS so the admin
# dashboard sees coredns_dns_requests_total for UDP/TCP and DoH. :9153 is
# the scrape listener (shared across blocks).
https://.:8443 {
	prometheus :9153
	qstat
	errors
	log
	admin {
		db /var/lib/coredns/admin.sqlite
		data /var/lib/coredns/admin-zones
		role primary
		bootstrap_admin admin
		advertise 172.30.53.10:53
	}
	transfer {
		to 172.30.53.20 172.30.53.30
	}
}

. {
	prometheus :9153
	qstat
	admin
	transfer {
		to 172.30.53.20 172.30.53.30
	}
}

# split-horizon-cache proof: cache in front of admin on its own origin.
# cache-split.example. is created via the API; short TTLs so checks complete
# inside one test stage. ACL-name cache keys keep the internal view answer
# from leaking to public-source clients.
cache-split.example. {
	prometheus :9153
	cache 10 {
		disable denial
		netmask 24
	}
	admin
}

# Live ns1 regression (pg.db.rwx.dev): public `*` catch-all, internal `*`
# catch-all, more-specific internal exact, prefetch. Prefetch used to call
# admin as 0.0.0.0 and write the public A into the LAN cache key.
# prefetch 1 / 90% fires on every cache hit so the poison is exercised, not
# hoped-for.
horizon.example. {
	prometheus :9153
	cache 30 {
		success 9984 30 1
		disable denial
		prefetch 1 1m 90%
	}
	admin
}

# Primary: dns-update-persistent owns example.com.
# Do not also configure file, auto, secondary, or secondary-persistent here.
example.com {
	prometheus :9153
	health :8080
	errors
	log

	tsig {
		secret updater.example.com. Y29yZWRucy1pbnRlZ3JhdGlvbi10ZXN0LWtleSEh
		require_opcode UPDATE
	}

	# Singleton overlay: ACL views for this Corefile primary, then Next to
	# dns-update-persistent for the public zonefile. Admin does not own example.com.
	qstat
	admin

	dns-update-persistent {
		file /var/lib/coredns/db.example.com
		mutable A AAAA NS CNAME MX TXT SRV NAPTR DS SSHFP TLSA CAA URI LOC HINFO RP HTTPS SVCB PTR EUI48 EUI64 CERT KX AFSDB CDS CDNSKEY OPENPGPKEY SMIMEA
	}

	ixfr

	# Tester AXFR (172.30.53.30). Secondary IP is listed so NOTIFY is sent.
	transfer {
		to 172.30.53.20 172.30.53.30
	}
}
