https://.:8443 {
	prometheus :9153
	qstat
	errors
	log
	admin {
		db /var/lib/coredns/admin.sqlite
		data /var/lib/coredns/admin-zones
		role secondary
		dns 172.30.53.10:53
	}
}

. {
	prometheus :9153
	qstat
	admin
}

# Secondary: secondary-persistent transfers example.com from the primary
# and writes the same RFC 1035 master after each successful AXFR/IXFR.
example.com {
	prometheus :9153
	health :8080
	errors
	log

	secondary-persistent {
		transfer from 172.30.53.10
		persist /var/lib/coredns/db.example.com
	}

	transfer {
		to 172.30.53.30
	}
}
